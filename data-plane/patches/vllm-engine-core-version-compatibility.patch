+/// Decode a release-specific output layout while keeping tensor auxiliary-frame indices unchanged.
+pub fn decode_engine_core_outputs_for<Frame>(
+    frames: &[Frame],
+    protocol: EngineCoreProtocol,
+) -> Result<EngineCoreOutputs>
+where
+    Frame: AsRef<[u8]>,
+{
+    let first_frame = frames.first().ok_or_else(|| ext_value_decode!("missing output frame"))?;
+    let mut outputs: EngineCoreOutputs = if matches!(
+        protocol,
+        EngineCoreProtocol::V0_20 | EngineCoreProtocol::V0_21ToV0_25
+    ) {
+        // v0.26 inserted EC metadata at position 9; normalize older arrays before typed decoding.
+        let mut value = crate::protocol::decode_value(first_frame.as_ref())?;
+        if let rmpv::Value::Array(envelope) = &mut value
+            && let Some(rmpv::Value::Array(batch)) = envelope.get_mut(1)
+        {
+            for output in batch {
+                if let rmpv::Value::Array(fields) = output
+                    && fields.len() > 9
+                {
+                    fields.insert(9, rmpv::Value::Nil);
+                }
+            }
+        }
+        rmpv::ext::from_value(value).map_err(|error| Error::Decode {
+            target_type: "EngineCoreOutputs",
+            message: error.to_string(),
+        })?
+    } else {
+        decode_msgpack(first_frame.as_ref())?
+    };
     outputs.resolve_in_place(frames)?;
     Ok(outputs)
 }
